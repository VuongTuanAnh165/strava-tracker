# Strava Multi-App Config (JSON array — each app has clientId, clientSecret, webhookToken)
# Add more objects to the array for additional apps (max 5 apps = 50 users)
STRAVA_APPS_CONFIG=[{"clientId":"your_app1_client_id","clientSecret":"your_app1_secret","webhookToken":"your_app1_webhook_token"},{"clientId":"your_app2_client_id","clientSecret":"your_app2_secret","webhookToken":"your_app2_webhook_token"}]

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your_key_here...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# App Config
APP_URL=http://localhost:3000
ADMIN_SECRET=a_secret_for_admin_access
